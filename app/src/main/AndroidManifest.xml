<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        PRIVACY GUARANTEE: this app has no network access.
        The INTERNET permission is not requested, and is force-removed in case any library
        tries to add it. CI checks the final APK and fails the build if it appears.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- Only used while she records her own voice (message banking). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!--
        The Piper Voice Engine is a separate app (GPL). This app speaks through it with Android's
        standard TextToSpeech API, and manages its voices (list, back up, restore, remove) through
        its provider, which only apps signed with the same key may use. The permission is declared
        here too, so the two apps can be installed in either order.
    -->
    <permission
        android:name="uk.elizabeth.speech.permission.MANAGE_VOICES"
        android:label="Manage installed voices"
        android:protectionLevel="signature" />
    <uses-permission android:name="uk.elizabeth.speech.permission.MANAGE_VOICES" />

    <!-- Lets the app find the speech engines installed on the tablet, including the Piper Voice Engine. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <package android:name="uk.elizabeth.speech" />
    </queries>

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Elizabeth"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Off unless a carer turns on "Use as the tablet's home screen" in Settings. Then the
            app opens when the tablet starts or Home is pressed, and Android brings it straight
            back if it ever crashes, so she is never left without her voice.
        -->
        <activity-alias
            android:name=".HomeScreen"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
